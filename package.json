{
  "name": "dsh-searxng-search",
  "version": "0.4.3",
  "description": "One-click local search engine: no API key, free, no tracking. Aggregates several fast engines and picks the best route for your network.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "engines.js",
    "engine-api.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "screenshots.json",
    "scripts/bootstrap-searxng.sh",
    "scripts/bootstrap-searxng.ps1",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "searxng",
    "web-search",
    "metasearch",
    "search-engine",
    "local-first"
  ],
  "author": "Jfreey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jfreey/dsh-searxng-search.git"
  },
  "homepage": "https://github.com/Jfreey/dsh-searxng-search#readme",
  "bugs": {
    "url": "https://github.com/Jfreey/dsh-searxng-search/issues"
  }
}
